{
  "name": "@aidemic/email-server",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Express email API backed by Nodemailer (SMTP).",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
