# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated keys accepted in the `x-api-key` header. Required in
# production; if unset in development the API runs unauthenticated.
API_KEYS=dev-key-change-me

# Comma-separated browser origins allowed to call the API. Leave empty for a
# server-to-server deployment (all cross-origin browser requests are refused).
ALLOWED_ORIGINS=

# Fixed-window rate limit applied per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Reverse proxies in front of this server (0 = none). Leave at 0 unless you
# really are behind one -- a wrong value lets clients spoof their IP and
# sidestep the rate limit.
TRUST_PROXY=0

# Max JSON body size (attachments are base64 in the body, so this caps them).
MAX_BODY_SIZE=25mb

# ---- SMTP (Gmail) ----
# Leave SMTP_HOST empty in development to auto-provision an Ethereal test
# inbox: nothing is delivered and each response carries a `previewUrl`.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (ports 587/25)
SMTP_SECURE=false
# Your full Gmail address.
SMTP_USER=you@gmail.com
# NOT your Google password: a 16-character App Password from
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
# Paste it without spaces.
SMTP_PASS=xxxxxxxxxxxxxxxx

# Default sender, used when a request omits `from`. Gmail rewrites this to the
# SMTP_USER account unless the address is a verified "Send mail as" alias, so
# keep the email here identical to SMTP_USER.
MAIL_FROM="AIDemic <you@gmail.com>"
# Optional default Reply-To.
MAIL_REPLY_TO=

# ---- Delivery tuning ----
# Transient-failure retries per message (0 disables retrying).
SEND_MAX_RETRIES=2
# Messages sent in parallel by POST /api/email/bulk.
BULK_CONCURRENCY=5
