NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (no NEXT_PUBLIC_ prefix -- never sent to the browser). Bypasses
# Row Level Security; used by the mark-answers route to persist assignment
# attempts so students cannot write their own grades.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI-compatible AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=your-ai-provider-key

# Optional OpenRouter attribution
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AIDemic

# Text-to-speech (AI Podcasts). Defaults to OpenRouter's OpenAI-compatible
# /audio/speech endpoint. Falls back to AI_API_KEY if TTS_API_KEY is unset.
# Podcasts are a two-host dialogue -- TTS_VOICE is the host, TTS_VOICE_SECONDARY
# is the co-host. Both must be voices supported by the model -- for the default
# model that's Eve, Ara, Rex, Sal, or Leo.
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=Eve
TTS_VOICE_SECONDARY=Leo
TTS_API_KEY=

# Transactional email via Brevo API. All optional: if any is unset,
# emails are skipped with a console warning and signup still works normally.
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_FROM="AIDemic <noreply@yourdomain.com>"

# For the weekly-parent-digest Edge Function. Leave empty in dev (endpoint is open).
BULK_EMAIL_SECRET=

# Branding and links used by every email template. APP_URL has no NEXT_PUBLIC_
# prefix on purpose -- it is only read server-side, to build absolute URLs for
# email CTAs. SUPPORT_EMAIL is required by the shared email layout.
APP_NAME=AIDemic
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@yourdomain.com
