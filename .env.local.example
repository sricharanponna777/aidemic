NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (no NEXT_PUBLIC_ prefix -- never sent to the browser). Bypasses
# Row Level Security; used by the mark-answers route to persist assignment
# attempts so students cannot write their own grades.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Signs the short-lived role cookie in src/proxy.ts so most dashboard
# navigations skip the user_profiles role-check query (defense-in-depth only
# -- RLS is the real backstop). Optional: unset just disables the cache and
# every request re-queries, so it's safe to leave out. Generate with
# `openssl rand -base64 32`.
ROLE_CACHE_SECRET=

# OpenAI-compatible AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=your-ai-provider-key

# Vision model used to transcribe photographed handwriting on printed papers.
# Optional -- falls back to AI_MODEL, which must then be multimodal.
AI_VISION_MODEL=

# Optional OpenRouter attribution
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AIDemic

# Text-to-speech (AI Podcasts). Defaults to OpenRouter's OpenAI-compatible
# /audio/speech endpoint. Falls back to AI_API_KEY if TTS_API_KEY is unset.
# Podcasts are a two-host dialogue -- TTS_VOICE is the host, TTS_VOICE_SECONDARY
# is the co-host. Both must be voices supported by the model -- for the default
# model that's Eve, Ara, Rex, Sal, or Leo.
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=Eve
TTS_VOICE_SECONDARY=Leo
TTS_API_KEY=

# Transactional email via Brevo API. All optional: if any is unset,
# emails are skipped with a console warning and signup still works normally.
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_FROM="AIDemic <noreply@aidemic.co.uk>"

# Shared cache (curriculum lookups, AI topic-validation verdicts) AND the shared
# window for the auth rate limiter, via Upstash Redis's REST API -- works from
# serverless/edge functions as well as a long-running server. Optional, but the
# two consumers degrade differently: caching is simply skipped, while rate limits
# fall back to a per-process counter, which on serverless limits one instance
# rather than the deployment. Set it in production.
# Create a free database at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for /api/email/bulk, the endpoint the weekly-parent-digest Edge
# Function posts to. REQUIRED in every environment, dev included: with it unset
# the endpoint answers 503 and sends nothing, because the alternative -- skipping
# the auth check -- turns one forgotten variable into an unauthenticated
# "send mail as AIDemic" endpoint. Set it here AND as the Edge Function's
# BULK_EMAIL_SECRET secret; the two must match.
BULK_EMAIL_SECRET=

# Branding and links used by every email template. APP_URL has no NEXT_PUBLIC_
# prefix on purpose -- it is only read server-side, to build absolute URLs for
# email CTAs. SUPPORT_EMAIL is required by the shared email layout.
APP_NAME=AIDemic
APP_URL=https://aidemic.co.uk
SUPPORT_EMAIL=support@aidemic.co.uk

# How many proxies sit in front of the app, for reading the client IP out of
# X-Forwarded-For in the auth rate limiter. That header is a list each proxy
# appends to, so only the last N entries are trustworthy and everything to their
# left is client-supplied. Default 1 suits a single platform edge (Vercel, nginx).
# Set to 0 if the app is exposed directly, which makes it ignore the header.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# What the AI rate limiter does when its database RPC errors. Unset, it fails
# CLOSED in production (an uncapped bill is worse than a paused feature) and OPEN
# in development. Set explicitly to override either default.
AI_RATE_LIMIT_FAIL_CLOSED=
